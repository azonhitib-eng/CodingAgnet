{
  "name": "codingagent-backend",
  "version": "0.1.0",
  "description": "Portable, local-first coding-agent platform backend — catalog management, host detection, compatibility evaluation, install planning, safety analysis, and workflow orchestration. Plans are informational only and are never executed.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    },
    "./workflow": {
      "import": "./dist/workflow/index.js",
      "types": "./dist/workflow/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./frontend-contracts": {
      "import": "./dist/frontend-contracts/index.js",
      "types": "./dist/frontend-contracts/index.d.ts"
    },
    "./app-shell": {
      "import": "./dist/app-shell/index.js",
      "types": "./dist/app-shell/index.d.ts"
    },
    "./session": {
      "import": "./dist/session/index.js",
      "types": "./dist/session/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./commands": {
      "import": "./dist/commands/index.js",
      "types": "./dist/commands/index.d.ts"
    }
  },
  "bin": {
    "codingagent-cli": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "app-shell": "tsx src/app-shell/server.ts",
    "app-shell:demo": "tsx src/app-shell/server.ts",
    "app-shell:open": "tsx src/app-shell/server.ts --open",
    "app-shell:desktop": "tsx scripts/desktop-launch.ts",
    "app-shell:help": "tsx src/app-shell/server.ts --help",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "ELECTRON_DEV=1 electron electron/main.cjs",
    "desktop:build": "npm run build && npx electron-builder --config electron-builder.config.js",
    "desktop:pack": "npm run build && npx electron-builder --config electron-builder.config.js --dir",
    "desktop:installer": "npm run build && npx electron-builder --config electron-builder.config.js --publish never",
    "generate-host-profile": "tsx src/cli/main.ts detect-host --json",
    "preflight": "tsx scripts/preflight.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "coding-agent",
    "model-catalog",
    "host-detection",
    "compatibility",
    "install-planning",
    "safety-evaluation",
    "workflow",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.2",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
